<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="1774958689066-2" author="Tasneem Gad">
        <createTable tableName="product_product_sizes">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_product_product_sizes"/>
            </column>
            <column name="version" type="INT"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="modified_by" type="VARCHAR(255)"/>
            <column name="created_date" type="TIMESTAMP"/>
            <column name="modified_date" type="TIMESTAMP"/>
            <column name="product_id" type="BIGINT"/>
            <column name="product_size_id" type="BIGINT"/>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="product_id" 
                                 baseTableName="product_product_sizes" 
                                 constraintName="FK_product_product_sizes_ON_product" 
                                 referencedColumnNames="id" 
                                 referencedTableName="products"/>

        <addForeignKeyConstraint baseColumnNames="product_size_id" 
                                 baseTableName="product_product_sizes" 
                                 constraintName="FK_product_product_sizes_ON_product_size" 
                                 referencedColumnNames="id" 
                                 referencedTableName="product_sizes"/>
    </changeSet>

</databaseChangeLog>