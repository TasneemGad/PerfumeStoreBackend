<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="1774721697441-11" author="Tasneem Gad">
        <createTable tableName="payment_statuses">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_payment_statuses"/>
            </column>
            <column name="arabic_name" type="NVARCHAR(255)"/>
            <column name="english_name" type="VARCHAR(255)"/>
            <column name="is_enabled" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="code" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="modified_by" type="VARCHAR(255)"/>
            <column name="created_date" type="timestamp"/>
            <column name="modified_date" type="timestamp"/>

            <column name="status_color" type="VARCHAR(20)"/>
        </createTable>

        <insert tableName="payment_statuses">
            <column name="code" value="PENDING_VERIFICATION"/>
            <column name="arabic_name" value="قيد المراجعة"/>
            <column name="english_name" value="Pending Verification"/>
            <column name="is_enabled" valueBoolean="true"/>
            <column name="created_date" valueDate="NOW()"/>
        </insert>

        <insert tableName="payment_statuses">
            <column name="code" value="PAID"/>
            <column name="arabic_name" value="تم الدفع"/>
            <column name="english_name" value="Paid"/>
            <column name="is_enabled" valueBoolean="true"/>
            <column name="created_date" valueDate="NOW()"/>
        </insert>

        <insert tableName="payment_statuses">
            <column name="code" value="REJECTED"/>
            <column name="arabic_name" value="مرفوض"/>
            <column name="english_name" value="Rejected"/>
            <column name="is_enabled" valueBoolean="true"/>
            <column name="created_date" valueDate="NOW()"/>
        </insert>
    </changeSet>

</databaseChangeLog>
