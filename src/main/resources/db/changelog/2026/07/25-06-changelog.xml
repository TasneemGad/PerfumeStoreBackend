<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="1774721697441-15" author="Tasneem Gad">
        <createTable tableName="products">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_products"/>
            </column>
            <column name="arabic_name" type="NVARCHAR(255)"/>
            <column name="english_name" type="VARCHAR(255)"/>
            <column name="is_enabled" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="code" type="VARCHAR(255)"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="modified_by" type="VARCHAR(255)"/>
            <column name="created_date" type="timestamp"/>
            <column name="modified_date" type="timestamp"/>

            <column name="price" type="DECIMAL(10, 2)"/>
            <column name="discount_price" type="DECIMAL(10, 2)"/>
            <column name="image" type="VARCHAR(500)"/>
            <column name="description" type="NVARCHAR(1000)"/>
            <column name="gender" type="VARCHAR(20)"/>
            <column name="category_id" type="BIGINT"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="products"
                                 baseColumnNames="category_id"
                                 constraintName="fk_products_categories"
                                 referencedTableName="categories"
                                 referencedColumnNames="id"/>

    </changeSet>

</databaseChangeLog>