<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="1774721697441-5" author="Tasneem Gad">
        <createTable tableName="shipping_details">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_shipping_details"/>
            </column>
            <column name="arabic_name" type="NVARCHAR(255)"/>
            <column name="english_name" type="VARCHAR(255)"/>
            <column name="is_enabled" type="BOOLEAN"/>
            <column name="code" type="VARCHAR(255)"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="modified_by" type="VARCHAR(255)"/>
            <column name="created_date" type="timestamp"/>
            <column name="modified_date" type="timestamp"/>

            <column name="full_name" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="phone" type="VARCHAR(50)"/>

            <column name="street_address" type="VARCHAR(500)"/>

        </createTable>
    </changeSet>

</databaseChangeLog>